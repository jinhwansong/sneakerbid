// =============================================================================
// Data model: context/DATA_MODEL.md + OAuth(Google/Kakao) + Wishlist(찜하기)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums (context + OAuth)
// -----------------------------------------------------------------------------
enum Role {
  USER
  ADMIN
  BOT // 경매 봇 (입찰 시뮬레이션)
}

enum OAuthProvider {
  GOOGLE
  KAKAO
}

enum AuctionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum BidSourceType {
  USER
  BOT
}

enum WalletTxType {
  BID_HOLD
  BID_RELEASE
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum WalletRefType {
  AUCTION
  ORDER
  BID
  SYSTEM
}

// -----------------------------------------------------------------------------
// User & OAuth (구글/카카오 로그인)
// -----------------------------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  nickname  String
  role      Role     @default(USER)
  balance   Int      @default(0) // 시뮬레이션 지갑
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts   OAuthAccount[]
  bids            Bid[]
  orders          Order[]          @relation("OrderBuyer")
  walletTx        WalletTransaction[]
  wishlists       Wishlist[]
  wonAuctions     Auction[]        @relation("AuctionWinner")
}

model OAuthAccount {
  id                String         @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String         // Google/Kakao 쪽 고유 id
  email             String?
  profileImageUrl   String?
  createdAt         DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Sneaker (상품 메타 + 프론트 상세 필드)
// -----------------------------------------------------------------------------
model Sneaker {
  id             String   @id @default(uuid())
  name           String   // modelName (API 응답 시 modelName으로 매핑)
  brand          String
  color          String   // colorway
  description    String?
  sizeOptions    String[] // ["260","265","270"] 등
  imageUrl       String
  popularityScore Int     @default(0)
  // 프론트 상세용
  styleCode      String?
  releaseYear    Int?
  condition      String?
  origin         String?
  boxIncluded    Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auctions Auction[]
}

// -----------------------------------------------------------------------------
// Auction (경매 세션)
// -----------------------------------------------------------------------------
model Auction {
  id               String        @id @default(uuid())
  sneakerId        String
  size             String        // "270" 등 (단일 사이즈)
  startPrice       Int
  currentPrice     Int
  buyNowPrice      Int?
  minimumIncrement Int
  status           AuctionStatus @default(OPEN)
  endTime          DateTime
  winnerUserId     String?
  closedAt         DateTime?
  version          Int           @default(0)
  lastExtendedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sneaker   Sneaker   @relation(fields: [sneakerId], references: [id], onDelete: Restrict)
  winner    User?     @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids      Bid[]
  orders    Order[]
  wishlists Wishlist[]

  @@index([status, endTime])
  @@index([sneakerId, size, status])
}

// -----------------------------------------------------------------------------
// Bid (입찰 기록, immutable)
// -----------------------------------------------------------------------------
model Bid {
  id         String        @id @default(uuid())
  auctionId  String
  userId     String
  bidPrice   Int
  sourceType BidSourceType @default(USER)
  strategyType String?     // BOT일 때 AGGRESSIVE | CONSERVATIVE | SNIPER
  createdAt  DateTime     @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([auctionId, createdAt(sort: Desc)])
  @@index([auctionId, bidPrice(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Order (정산 시도)
// -----------------------------------------------------------------------------
model Order {
  id            String      @id @default(uuid())
  auctionId     String
  buyerUserId   String
  finalPrice    Int
  status        OrderStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime    @default(now())
  paidAt        DateTime?

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  buyer   User    @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)

  @@index([auctionId])
  @@index([buyerUserId])
}

// -----------------------------------------------------------------------------
// WalletTransaction (감사/정산 추적)
// -----------------------------------------------------------------------------
model WalletTransaction {
  id        String         @id @default(uuid())
  userId    String
  amount    Int            // 음수=차감, 양수=입금
  type      WalletTxType
  refType   WalletRefType
  refId     String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([refType, refId])
}

// -----------------------------------------------------------------------------
// Wishlist (찜하기: 유저별 경매 단위)
// -----------------------------------------------------------------------------
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  auctionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}
